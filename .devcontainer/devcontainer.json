{
  "name": "pivot-ai-handball",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--gpus=all",
    "--shm-size=8g"
  ],
  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,video",
    "PYTHONUNBUFFERED": "1",
    "PIP_CACHE_DIR": "/home/vscode/.cache/pip",
    "ROBOFLOW_API_KEY": "${localEnv:ROBOFLOW_API_KEY}"
  },
  "mounts": [
    "source=pivot-ai-handball-pip-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=pivot-ai-handball-torch-cache,target=/home/vscode/.cache/torch,type=volume",
    "source=pivot-ai-handball-torch-cache,target=/home/vscode/.cache/matplotlib,type=volume",
    "source=pivot-ai-handball-ultralytics-cache,target=/home/vscode/.config/Ultralytics,type=volume"
  ],
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev]' --extra-index-url https://download.pytorch.org/whl/cu132 -c .devcontainer/constraints.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "vscode"
}
